{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "vite build && npm run build:server",
    "render-build": "npm run build",
    "prestart": "node -e \"const fs = require('fs'); const cp = require('child_process'); if (!fs.existsSync('dist/server.js') || !fs.existsSync('dist/server.cjs')) { console.log('[Server] Auto-building production server bundles...'); cp.execSync('npm run build:server', { stdio: 'inherit' }); }\"",
    "start": "node server.js",
    "start:esm": "node dist/server.js",
    "start:cjs": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "protobufjs": false
  }
}

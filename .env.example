# =====================================================================
# ISHWARI SECONDARY SCHOOL - ENVIRONMENT CONFIGURATION
# =====================================================================

# --- FRONTEND ENVIRONMENT VARIABLES (Vercel) ---
# Set this in your Vercel Project Settings > Environment Variables
# Points the React frontend to the Render backend API HTTPS origin.
# Example: https://ishwari-school-backend.onrender.com
VITE_API_URL="https://your-backend-api.onrender.com"

# --- BACKEND ENVIRONMENT VARIABLES (Render / Node.js) ---
# Port number for the Express server (Render automatically sets PORT)
PORT=3000
NODE_ENV="production"

# Cryptographic secret for signing stateless session tokens (min 32 chars)
# If omitted, server generates a high-entropy random runtime secret.
SESSION_SECRET=""

# Allowed frontend origins for CORS (comma-separated if multiple)
# Allows your Vercel frontend domain to securely connect to Render backend
FRONTEND_URL="https://your-frontend.vercel.app"
ALLOWED_ORIGINS="https://your-frontend.vercel.app,https://localhost:3000"

# --- PERSISTENCE & DATABASE ---
# Firestore project and database configuration (automatic in AI Studio)
FIRESTORE_DATABASE_ID="ai-studio-ishwarisecondary-62e4059d-8fd8-48dc-9660-818a91224b4e"

# --- GEMINI AI & CLOUD RUN (Optional) ---
GEMINI_API_KEY=""
APP_URL=""

